{
  "openapi": "3.0.3",
  "info": {
    "title": "Cinemex API",
    "version": "1.0.0",
    "description": "API intermedia para consultar películas de TMDB. Documentación del proyecto Cinemex."
  },
  "servers": [
    {
      "url": "https://cinemex-api-bye8gdg4chbsa7e3.northcentralus-01.azurewebsites.net/api/peliculas"
    }
  ],
  "paths": {
    "": {
      "get": {
        "summary": "Health Check",
        "description": "Verifica que la API esté en línea y muestra las rutas disponibles.",
        "responses": {
          "200": {
            "description": "API funcionando correctamente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Verifica que la API esté en línea.",
        "responses": {
          "200": {
            "description": "API funcionando correctamente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/populares": {
      "get": {
        "summary": "Películas populares",
        "description": "Obtiene una lista de las películas más populares del momento.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de películas populares",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginaPeliculas" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/cartelera": {
      "get": {
        "summary": "Películas en cartelera",
        "description": "Obtiene las películas que están actualmente en cines.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de películas en cartelera",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginaPeliculas" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/proximos-estrenos": {
      "get": {
        "summary": "Próximos estrenos",
        "description": "Obtiene las películas que se estrenarán próximamente.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de próximos estrenos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginaPeliculas" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/{id}": {
      "get": {
        "summary": "Detalle de película",
        "description": "Obtiene los detalles completos de una película por su ID de TMDB, incluyendo su clasificación.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de la película en TMDB",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la película",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pelicula" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/{id}/reparto": {
      "get": {
        "summary": "Reparto de película",
        "description": "Obtiene la lista de actores principales de una película.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de la película en TMDB",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de actores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/IntegranteReparto" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/docs": {
      "get": {
        "summary": "Documentación HTML",
        "description": "Devuelve la documentación en HTML.",
        "responses": {
          "200": { "description": "Documentación en HTML" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Especificación OpenAPI",
        "description": "Devuelve el contrato OpenAPI en JSON.",
        "responses": {
          "200": { "description": "Especificación OpenAPI" }
        }
      }
    },
    "/swagger": {
      "get": {
        "summary": "Swagger UI",
        "description": "Interfaz interactiva de Swagger.",
        "responses": {
          "200": { "description": "Página HTML de Swagger UI" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "Error de la solicitud o del servicio",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "servicio": { "type": "string" },
          "status": { "type": "string" },
          "endpoints": { "type": "array", "items": { "type": "string" } }
        }
      },
      "PaginaPeliculas": {
        "type": "object",
        "properties": {
          "pagina": { "type": "integer" },
          "totalPaginas": { "type": "integer" },
          "totalResultados": { "type": "integer" },
          "peliculas": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Pelicula" }
          }
        }
      },
      "Pelicula": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "titulo": { "type": "string" },
          "sinopsis": { "type": "string" },
          "fechaEstreno": { "type": "string", "nullable": true },
          "duracion": { "type": "integer" },
          "generos": { "type": "array", "items": { "type": "string" } },
          "clasificacion": { "type": "string" },
          "cartel": { "type": "string", "nullable": true },
          "calificacion": { "type": "number", "format": "double" },
          "estado": { "type": "string" }
        }
      },
      "IntegranteReparto": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "nombre": { "type": "string" },
          "personaje": { "type": "string" },
          "foto": { "type": "string", "nullable": true },
          "orden": { "type": "integer" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": { "type": "integer" },
          "error": { "type": "string" }
        }
      }
    }
  }
}
